# Sales Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Database Configuration
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=192.168.1.132
POSTGRES_PORT=5432

# Authentication (optional - leave empty to disable login)
SECRET_KEY=

# Allowed origins for POST request validation (optional, comma-separated)
# If empty or not set, Origin validation is skipped (permissive for dev)
# Example: ALLOWED_ORIGINS=http://localhost:8050,https://dashboard.example.com
ALLOWED_ORIGINS=
